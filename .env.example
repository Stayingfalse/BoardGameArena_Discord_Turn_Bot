DISCORD_TOKEN=paste_your_bot_token_here
# Optional but recommended during setup: paste your Discord server ID here for fast guild-only slash command sync
DISCORD_GUILD_ID=
# Optional: set to 1 once to delete stale global slash commands before guild sync
DISCORD_CLEAR_GLOBAL_COMMANDS=0
BGA_POLL_SECONDS=15
BGA_DB_PATH=bga_bot.db
BGA_WS_URL=wss://ws-x1.boardgamearena.com/connection/websocket
# Optional: set to 1 to re-enable the tableinfos HTTP fallback for end-of-game detection
BGA_ENABLE_TABLEINFOS_FALLBACK=0
LOG_LEVEL=INFO
# Message language: a file in src/bga_turn/locales/ (only "en" ships today).
BOT_LANG=en
# Optional global defaults (can be overridden per-server with /bga settings):
# Set to 1 to enable recruiting-only mode — the bot posts the recruit/invite embed and
# automatically deletes it and removes the watch once the game moves to in-progress (stage 2).
BGA_RECRUITING_ONLY=0
# Delete the original message containing a BGA link once the bot's status message has
# turned into the table card. Requires the Manage Messages permission.
# Blank: servers the bot joins from now on start with it ON; others keep it OFF.
# 1 or 0: use that value as the default everywhere. Admins can change it per server.
BGA_DELETE_INVITE_MESSAGE=
# Channel ID to force all bot notifications into a single channel, regardless of which
# channel originally triggered the watch registration.
BGA_FORCED_CHANNEL_ID=

# --- Codenames (codenames.game) ---
# Set to 0 to ignore codenames.game room links and hide the /codenames commands.
CODENAMES_ENABLED=1
# Optional "|"-separated names the bot picks from when it first joins a room. Leave blank
# for the built-in list. Avoid brackets: the site strips them.
# Example: CODENAMES_BOT_NAMES=🤖 Agent Turnkeeper|🤖 Curious Cat
CODENAMES_BOT_NAMES=
# Stop watching a room that has had nobody in it for this many hours.
CODENAMES_IDLE_HOURS=12

# --- Onboarding dashboard (optional) ---
# Set to 1 to enable the web dashboard on port 8080.
DASHBOARD_ENABLED=0
# Interface to listen on; use 127.0.0.1 when a local reverse proxy fronts the dashboard.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Public base URL used for OAuth2 redirect URIs (no trailing slash).
# For production use HTTPS (HTTP is only accepted for localhost).
DASHBOARD_BASE_URL=http://localhost:8080
# Discord application credentials — required for the dashboard OAuth2 login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Random secret string used to sign dashboard form (CSRF) tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=
# Comma-separated Discord user IDs that bypass MANAGE_GUILD and can view/manage all servers.
# Example: GLOBAL_ADMIN_DISCORD_IDS=123456789012345678,987654321098765432
GLOBAL_ADMIN_DISCORD_IDS=
